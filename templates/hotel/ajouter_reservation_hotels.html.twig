{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assetsC/css/bootstrap.css') }}">
    <link rel="stylesheet" href="{{ asset('assetsC/css/style.css') }}">

    <style>
        :root {
            --gold: #D4AF37;
            --dark-gold: #B8860B;
            --dark-blue: #0A1A2F;
            --light-blue: #1E3A8A;
            --white: #F8F8F8;
        }

        .reservation-container {
            max-width: 600px;
            margin: 40px auto;
            padding: 0;
            background: rgba(10, 26, 47, 0.9);
            border-radius: 10px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            border: 1px solid var(--gold);
            overflow: hidden;
        }

        .reservation-header {
            background: linear-gradient(to right, var(--dark-blue), var(--light-blue));
            padding: 25px;
            color: var(--gold);
            text-align: center;
            border-bottom: 2px solid var(--gold);
        }

        .reservation-header h2 {
            margin: 0;
            font-size: 28px;
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            letter-spacing: 1px;
        }

        .reservation-header p {
            margin: 10px 0 0;
            font-size: 16px;
            color: var(--white);
            opacity: 0.9;
        }

        .form-container {
            padding: 25px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-control {
            width: 100%;
            padding: 12px 15px;
            margin-bottom: 0;
            background-color: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(212, 175, 55, 0.3);
            border-radius: 5px;
            color: var(--white);
            transition: all 0.3s ease;
        }

        .form-control:focus {
            background-color: rgba(255, 255, 255, 0.2);
            border-color: var(--gold);
            outline: none;
            box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.2);
            color: var(--white);
        }

        label {
            display: block;
            margin-bottom: 8px;
            color: var(--gold);
            font-weight: 500;
        }

        .submit-button {
            background: var(--gold);
            color: var(--dark-blue);
            padding: 14px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: all 0.3s ease;
            width: 100%;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-top: 10px;
        }

        .submit-button:hover {
            background: var(--dark-gold);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(212, 175, 55, 0.3);
        }

        .back-link {
            display: block;
            margin-top: 20px;
            text-align: center;
            color: var(--gold);
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .back-link:hover {
            color: var(--dark-gold);
            text-decoration: underline;
        }

        /* Style form errors */
        .form-error {
            color: #ff6b6b;
            font-size: 14px;
            margin-top: 5px;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="reservation-container">
        <div class="reservation-header">
            <h2>Réserver l'hôtel : {{ hotel.nom }}</h2>
            <p>Complétez le formulaire ci-dessous pour finaliser votre réservation.</p>
        </div>
        <div class="form-container">
            {{ form_start(form) }}
                {% for child in form %}
                    <div class="form-group">
                        {{ form_label(child) }}
                        {{ form_widget(child, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(child) }}
                    </div>
                {% endfor %}
                <button type="submit" class="submit-button">Réserver</button>
            {{ form_end(form) }}
            <a href="{{ path('app_dashboard') }}" class="back-link">
                ← Retour 
            </a>
        </div>
    </div>
{% endblock %}