<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Réservations - {{ hotel.nom }}</title>
    <style>
        body { font-family: DejaVu Sans, sans-serif; font-size: 12px; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid #444; padding: 6px; text-align: center; }
        th { background-color: #eee; }
        h2 { text-align: center; }
    </style>
</head>
<body>
    <h2>Réservations pour l'hôtel {{ hotel.nom }}</h2>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Check-in</th>
                <th>Check-out</th>
                <th>Type chambre</th>
                <th>Prix total</th>
            </tr>
        </thead>
        <tbody>
            {% for res in reservations %}
                <tr>
                    <td>#{{ res.idReservation }}</td>
                    <td>{{ res.checkInDate|date('d/m/Y') }}</td>
                    <td>{{ res.checkOutDate|date('d/m/Y') }}</td>
                    <td>{{ res.typeChambre }}</td>
                    <td>{{ res.getPrixTotal() }} TND</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">Aucune réservation pour cet hôtel.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</body>
</html>
