{% extends 'baseclient.html.twig' %}

{% block title %}Modifier Réservation{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .reservation-form-container {
            max-width: 800px;
            margin: 40px auto;
            background-color: rgba(10, 26, 47, 0.9);
            border-radius: 8px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            border: 1px solid var(--gold);
            overflow: hidden;
        }

        .form-header {
            background: linear-gradient(to right, var(--dark-blue), var(--light-blue));
            padding: 25px;
            color: white;
            border-bottom: 2px solid var(--gold);
            text-align: center;
        }

        .form-header h2 {
            font-family: 'Playfair Display', serif;
            color: var(--gold);
            margin: 0;
            font-size: 2rem;
        }

        .form-body {
            padding: 30px;
        }

        .form-group {
            margin-bottom: 25px;
        }

        .form-label {
            color: var(--gold);
            font-weight: 600;
            margin-bottom: 8px;
            display: block;
        }

        .form-control {
            background-color: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(212, 175, 55, 0.3);
            color: var(--white);
            padding: 12px 15px;
            border-radius: 4px;
            width: 100%;
            transition: all 0.3s;
        }

        .form-control:focus {
            border-color: var(--gold);
            box-shadow: 0 0 0 0.2rem rgba(212, 175, 55, 0.25);
            background-color: rgba(255, 255, 255, 0.1);
            color: var(--white);
        }

        .form-actions {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 30px;
        }

        .btn-submit {
            background-color: var(--gold);
            color: var(--dark-blue);
            border: none;
            padding: 10px 30px;
            font-weight: 600;
            border-radius: 4px;
            transition: all 0.3s;
        }

        .btn-submit:hover {
            background-color: var(--dark-gold);
            transform: translateY(-2px);
        }

        .btn-cancel {
            background-color: transparent;
            color: var(--white);
            border: 1px solid var(--white);
            padding: 10px 30px;
            font-weight: 600;
            border-radius: 4px;
            transition: all 0.3s;
        }

        .btn-cancel:hover {
            background-color: rgba(255, 255, 255, 0.1);
            border-color: var(--gold);
            color: var(--gold);
        }

        .is-invalid {
            border-color: #dc3545 !important;
        }

        .invalid-feedback {
            color: #dc3545;
            font-size: 0.85rem;
            margin-top: 5px;
        }

        @media (max-width: 768px) {
            .form-body {
                padding: 20px;
            }
            
            .form-actions {
                flex-direction: column;
                gap: 10px;
            }
            
            .btn-submit, .btn-cancel {
                width: 100%;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="reservation-form-container">
    <div class="form-header">
        <h2><i class="fas fa-edit me-2"></i> Modifier la Réservation</h2>
    </div>
    
    <div class="form-body">
        {# Afficher les messages flash #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} mb-4">{{ message }}</div>
            {% endfor %}
        {% endfor %}
        
        {{ form_start(form, {'attr': {'class': 'reservation-form'}}) }}
        
        {{ form_widget(form._token) }}
        
        {% for field in form %}
            {% if field.vars.name != '_token' %}
                <div class="form-group">
                    {{ form_label(field, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(field, {
                        'attr': {
                            'class': 'form-control' ~ (field.vars.errors|length > 0 ? ' is-invalid' : '')
                        }
                    }) }}
                    {{ form_errors(field) }}
                </div>
            {% endif %}
        {% endfor %}
        
        <div class="form-actions">
            <button type="submit" class="btn-submit">
                <i class="fas fa-save me-2"></i> Enregistrer
            </button>
            <a href="{{ path('afficher_reservation') }}" class="btn-cancel">
                <i class="fas fa-times me-2"></i> Annuler
            </a>
        </div>
        
        {{ form_end(form, {'render_rest': false}) }}
    </div>
</div>
{% endblock %}