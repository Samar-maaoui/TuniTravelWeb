{% extends 'baseadmin.html.twig' %}

{% block title %}Modifier un Hôtel{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1>Modifier un Hôtel</h1>

        <div class="card">
            <div class="card-body">
                {{ form_start(form) }}
                    <div class="mb-3">
                        {{ form_label(form.nom) }}
                        {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                        <div class="form-error">
                            {{ form_errors(form.nom) }}
                        </div>
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.prix_nuit) }}
                        {{ form_widget(form.prix_nuit, {'attr': {'class': 'form-control'}}) }}
                        <div class="form-error">
                            {{ form_errors(form.prix_nuit) }}
                        </div>
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.adresse) }}
                        {{ form_widget(form.adresse, {'attr': {'class': 'form-control'}}) }}
                        <div class="form-error">
                            {{ form_errors(form.adresse) }}
                        </div>
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.description) }}
                        {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 5}}) }}
                        <div class="form-error">
                            {{ form_errors(form.description) }}
                        </div>
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.est_disponible) }}
                        {{ form_widget(form.est_disponible, {'attr': {'class': 'form-check-input'}}) }}
                        <div class="form-error">
                            {{ form_errors(form.est_disponible) }}
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">Modifier</button>
                    <a href="{{ path('admin_hotel_list') }}" class="btn btn-secondary">Annuler</a>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
