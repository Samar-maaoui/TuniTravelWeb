{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

<div class="form-group">
    {{ form_label(form.titre) }}
    {{ form_widget(form.titre, {
        'attr': {
            'class': 'form-control custom-field' ~ (form.titre.vars.errors|length > 0 ? ' is-invalid' : '')
        }
    }) }}
    {% for error in form.titre.vars.errors %}
        <div class="invalid-feedback d-block">{{ error.message }}</div>
    {% endfor %}
</div>

<div class="form-group">
    {{ form_label(form.description) }}
    {{ form_widget(form.description, {
        'attr': {
            'class': 'form-control custom-field',
            'readonly': true,
            'id': 'post_description'
        }
    }) }}
    {% for error in form.description.vars.errors %}
        <div class="invalid-feedback d-block">{{ error.message }}</div>
    {% endfor %}
</div>

<div class="form-group">
    {{ form_label(form.date_publication) }}
    {{ form_widget(form.date_publication, {
        'attr': {
            'class': 'form-control custom-field'
        }
    }) }}
    {% for error in form.date_publication.vars.errors %}
        <div class="invalid-feedback d-block">{{ error.message }}</div>
    {% endfor %}
</div>

<div class="form-group">
    {{ form_label(form.date_expiration) }}
    {{ form_widget(form.date_expiration, {
        'attr': {
            'class': 'form-control custom-field'
        }
    }) }}
    {% for error in form.date_expiration.vars.errors %}
        <div class="invalid-feedback d-block">{{ error.message }}</div>
    {% endfor %}
</div>

<div class="form-group">
    {{ form_label(form.packvoyage) }}
    {{ form_widget(form.packvoyage, {
        'attr': {
            'class': 'form-control custom-field',
            'id': 'post_packvoyage'
        }
    }) }}
    {% for error in form.packvoyage.vars.errors %}
        <div class="invalid-feedback d-block">{{ error.message }}</div>
    {% endfor %}
</div>

<button type="submit" class="btn btn-primary">{{ button_label|default('Valider') }}</button>

{{ form_end(form) }}
