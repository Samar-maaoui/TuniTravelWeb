<form method="post" action="{{ path('admin_post_delete', {'id_post': post.idPost}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.idPost) }}">
<button class="delete-btn">
        <i class="fas fa-trash"></i> <!-- Trash icon -->
    </button></form>
