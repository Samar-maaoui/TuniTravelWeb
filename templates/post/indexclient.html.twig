{% block body %}
    
  
    <table class="table" id="posts" >
        <thead>
            <tr>
                <th>Titre</th>
                <th>Description</th>
                <th>Date_publication</th>
                <th>Date_expiration</th>
                <th>Statut</th>
                <th>Image_url</th>
       
            
            </tr>
        </thead>
        <tbody>
        {% for post in posts %}
            <tr>
                <td>{{ post.titre }}</td>
                <td>{{ post.description }}</td>
                <td>{{ post.datePublication ? post.datePublication|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ post.dateExpiration ? post.dateExpiration|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ post.statut }}</td>
                <td>{{ post.imageUrl }}</td>
          
              
            </tr>
        {% else %}
            <tr>
                <td colspan="8">No records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}

