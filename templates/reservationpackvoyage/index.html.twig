{% extends 'baseadmin.html.twig' %}

{% block body %}
    <h1>Reservationpackvoyage </h1>

    <table class="table">
        <thead>
            <tr>
                <th>Utilisateur</th>
                <th>Email</th>
                <th>Date</th>
                <th>Statut</th>
                <th>Paiement</th>
               
                <th>Places</th>
                <th>Montant</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for reservationpackvoyage in reservationpackvoyages %}
            <tr>
                <td>{{ reservationpackvoyage.utilisateur.nom }} {{ reservationpackvoyage.utilisateur.prenom }}</td>
                <td>{{ reservationpackvoyage.utilisateur.email }}</td>
                <td>{{ reservationpackvoyage.dateReservation ? reservationpackvoyage.dateReservation|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ reservationpackvoyage.statut }}</td>
                <td>{{ reservationpackvoyage.statutPaiement }}</td>
                
                <td>{{ reservationpackvoyage.placesDemandees }}</td>
                <td>{{ reservationpackvoyage.montantTotal }} TND</td>
        <td style="text-align: center;">
                <a href="{{ path('app_reservationpackvoyage_show', {'id_reservation': reservationpackvoyage.idReservation}) }}">
                <i class="fas fa-eye"></i>
                 </a>
        </td>

            </tr>
        {% else %}
            <tr>
                <td colspan="10">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
