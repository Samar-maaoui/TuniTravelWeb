{% extends 'baseclient.html.twig' %}

{% block title %}Modifier Feedback - ItinéRêves{% endblock %}

{% block body %}
<style>
    .form-label {
        font-weight: 600;
        margin-bottom: 8px;
        color: #4154f1;
    }

    .form-control {
        border-radius: 12px;
        padding: 12px;
        border: 1px solid #ccc;
    }

    .form-control:focus {
        border-color: #4154f1;
        box-shadow: 0 0 0 0.2rem rgba(65, 84, 241, 0.2);
    }

    .invalid-feedback {
        color: #dc3545;
        font-size: 0.85rem;
    }

    .btn {
        border-radius: 25px;
        padding: 10px 25px;
        font-weight: bold;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background: linear-gradient(135deg, #4154f1, #2536b8);
        border: none;
        color: white;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(65, 84, 241, 0.3);
    }

    .btn-secondary {
        background-color: transparent;
        border: 2px solid #4154f1;
        color: #4154f1;
    }

    .btn-secondary:hover {
        background-color: #f1f3ff;
        color: #2536b8;
    }

    /* Système d'étoiles amélioré */
    .rating-container {
        display: flex;
        flex-direction: row-reverse;
        justify-content: center;
        gap: 5px;
        margin-bottom: 20px;
    }

    .rating-container input {
        display: none;
    }

    .rating-container label {
        font-size: 2.5rem;
        color: #ddd;
        cursor: pointer;
        transition: color 0.3s, transform 0.3s;
    }

    /* Effet visuel quand survolé */
    .rating-container label:hover,
    .rating-container label:hover ~ label,
    .rating-container input:checked ~ label {
        color: #ffc107;
        transform: scale(1.1);
    }

    /* Animation pour les étoiles */
    .rating-container label {
        transform-origin: center;
        transition: all 0.3s ease;
    }

    .rating-container label:hover {
        transform: rotate(12deg) scale(1.2);
    }

    .rating-container input:checked + label {
        animation: pulse 0.5s;
    }

    @keyframes pulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.3); }
        100% { transform: scale(1.1); }
    }

    .rating-title {
        font-weight: 600;
        color: #4154f1;
        margin-bottom: 15px;
    }

    .alert {
        border-radius: 10px;
        font-size: 0.95rem;
        margin-bottom: 20px;
        padding: 12px 20px;
    }
    
    .alert-success {
        background-color: #e0f9ea;
        color: #0d6832;
        border-left: 4px solid #0d6832;
    }
    
    .alert-danger {
        background-color: #ffe5e5;
        color: #b71c1c;
        border-left: 4px solid #b71c1c;
    }
</style>

<section class="section text-center bg-light" style="padding: 60px 0;">
    <div class="container" style="max-width: 650px;">
        <h2 class="mb-4" style="font-family: 'Montserrat'; color: #4154f1;">Modifier votre avis</h2>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}

        {# Hidden note field from Symfony form - this is needed for the form to work #}
        {{ form_widget(form.note, {'attr': {'class': 'note-hidden-input'}}) }}

        {# Champ note personnalisé en étoiles #}
        <div class="mb-4">
            <p class="rating-title">Votre note</p>
            <div class="rating-container">
                {% for i in 5..1 %}
                    <input type="radio" id="star{{ i }}" class="star-input" value="{{ i }}" 
                           {{ feedback.note == i ? 'checked' : '' }}>
                    <label for="star{{ i }}" class="rating-label">★</label>
                {% endfor %}
            </div>
            {% if form.note.vars.errors|length %}
                <div class="invalid-feedback d-block">
                    {{ form_errors(form.note) }}
                </div>
            {% endif %}
        </div>

        {# Champ commentaire #}
        <div class="mb-4 text-start">
            {{ form_label(form.commentaire, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.commentaire, {
                'attr': {
                    'class': 'form-control ' ~ (form.commentaire.vars.errors|length ? 'is-invalid' : ''),
                    'placeholder': 'Partagez votre expérience avec nous...',
                    'rows': 5,
                    'style': 'resize: none;'
                }
            }) }}
            {% if form.commentaire.vars.errors|length %}
                <div class="invalid-feedback d-block">
                    {{ form_errors(form.commentaire) }}
                </div>
            {% endif %}
        </div>

        <div class="d-flex justify-content-center gap-3">
            <button type="submit" class="btn btn-primary">ENREGISTRER</button>
            <a href="{{ path('app_feedback_list') }}" class="btn btn-secondary">ANNULER</a>
        </div>

        {{ form_end(form) }}
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Récupérer le champ caché du formulaire Symfony
    const hiddenNoteInput = document.querySelector('.note-hidden-input');
    
    // Récupérer tous les boutons radio d'étoiles
    const starInputs = document.querySelectorAll('.star-input');
    
    // Si on a une note déjà sélectionnée (lors de l'affichage du formulaire), mettre à jour le champ caché
    starInputs.forEach(input => {
        if (input.checked) {
            hiddenNoteInput.value = input.value;
        }
        
        // Ajouter un événement pour mettre à jour le champ caché quand une étoile est cliquée
        input.addEventListener('change', function() {
            hiddenNoteInput.value = this.value;
        });
    });
    
    // Vérifier qu'une note est sélectionnée avant l'envoi du formulaire
    const form = document.querySelector('form');
    form.addEventListener('submit', function(event) {
        if (!hiddenNoteInput.value || hiddenNoteInput.value === '') {
            event.preventDefault();
            alert('Veuillez sélectionner une note entre 1 et 5 étoiles.');
        }
    });
});
</script>
{% endblock %}