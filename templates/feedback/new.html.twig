{% extends 'baseclient.html.twig' %}

{% block title %}Feedback - ItinéRêves{% endblock %}

{% block body %}
<style>
    .form-label {
        font-weight: 600;
        margin-bottom: 8px;
        color: #4154f1;
    }

    .form-control {
        border-radius: 12px;
        padding: 12px;
        border: 1px solid #ccc;
    }

    .form-control:focus {
        border-color: #4154f1;
        box-shadow: 0 0 0 0.2rem rgba(65, 84, 241, 0.2);
    }

    .invalid-feedback {
        color: #dc3545;
        font-size: 0.85rem;
    }

    .btn {
        border-radius: 25px;
        padding: 10px 25px;
        font-weight: bold;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background: linear-gradient(135deg, #4154f1, #2536b8);
        border: none;
        color: white;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(65, 84, 241, 0.3);
    }

    .btn-secondary {
        background-color: transparent;
        border: 2px solid #4154f1;
        color: #4154f1;
    }

    .btn-secondary:hover {
        background-color: #f1f3ff;
        color: #2536b8;
    }

    /* Système d'étoiles amélioré */
    .rating-container {
        display: flex;
        flex-direction: row-reverse;
        justify-content: center;
        gap: 5px;
        margin-bottom: 20px;
    }

    .rating-container input {
        display: none;
    }

    .rating-container label {
        font-size: 2.5rem;
        color: #ddd;
        cursor: pointer;
        transition: color 0.3s;
    }

    .rating-container label:hover,
    .rating-container label:hover ~ label,
    .rating-container input:checked ~ label {
        color: #ffc107;
    }

    .rating-title {
        font-weight: 600;
        color: #4154f1;
        margin-bottom: 15px;
    }

    .alert {
        border-radius: 10px;
        font-size: 0.95rem;
        margin-bottom: 20px;
        padding: 12px 20px;
    }
    
    .alert-success {
        background-color: #e0f9ea;
        color: #0d6832;
        border-left: 4px solid #0d6832;
    }
    
    .alert-danger {
        background-color: #ffe5e5;
        color: #b71c1c;
        border-left: 4px solid #b71c1c;
    }
</style>

<section class="section text-center bg-light" style="padding: 60px 0;">
    <div class="container" style="max-width: 650px;">
        <h2 class="mb-4" style="font-family: 'Montserrat'; color: #4154f1;">Donnez votre avis</h2>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}

        {# Hidden note field #}
        {{ form_widget(form.note, {'attr': {'class': 'hidden-note'}}) }}

        {# Star rating display #}
        <div class="mb-4">
            <p class="rating-title">Votre note</p>
            <div class="rating-container">
                {% for i in 5..1 %}
                    <input type="radio" id="star{{ i }}" name="star_rating" value="{{ i }}" 
                           class="rating-input" 
                           {% if form.note.vars.value == i %}checked{% endif %}
                           onclick="document.querySelector('#{{ form.note.vars.id }}').value = this.value;">
                    <label for="star{{ i }}" class="rating-label">★</label>
                {% endfor %}
            </div>
            {% if form.note.vars.errors|length %}
                <div class="invalid-feedback d-block">
                    {{ form_errors(form.note) }}
                </div>
            {% endif %}
        </div>

        {# Comment field #}
        <div class="mb-4 text-start">
            {{ form_label(form.commentaire, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.commentaire, {
                'attr': {
                    'class': 'form-control ' ~ (form.commentaire.vars.errors|length ? 'is-invalid' : ''),
                    'placeholder': 'Partagez votre expérience avec nous...',
                    'rows': 5,
                    'style': 'resize: none;'
                }
            }) }}
            {% if form.commentaire.vars.errors|length %}
                <div class="invalid-feedback d-block">
                    {{ form_errors(form.commentaire) }}
                </div>
            {% endif %}
        </div>

        <div class="d-flex justify-content-center gap-3">
            <button type="submit" class="btn btn-primary">ENVOYER</button>
            <a href="{{ path('app_feedback_list') }}" class="btn btn-secondary">VOIR MES FEEDBACKS</a>
        </div>

        {{ form_end(form) }}
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Set initial value if exists
    const currentNote = {{ form.note.vars.value|default(0) }};
    if (currentNote > 0) {
        document.querySelector('#{{ form.note.vars.id }}').value = currentNote;
    }

    // Form validation
    const form = document.querySelector('form');
    form.addEventListener('submit', function(event) {
        const noteInput = document.querySelector('#{{ form.note.vars.id }}');
        if (!noteInput.value) {
            event.preventDefault();
            alert('Veuillez sélectionner une note entre 1 et 5 étoiles.');
        }
    });
});
</script>
{% endblock %}