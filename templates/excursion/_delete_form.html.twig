<form method="post" action="{{ path('app_excursion_delete', {'id_excursion': excursion.idExcursion}) }}"
      onsubmit="return confirm('Voulez-vous vraiment supprimer cette excursion ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ excursion.idExcursion) }}">
    <button class="btn btn-danger btn-sm">Supprimer</button>
</form>
