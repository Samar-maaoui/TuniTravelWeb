{% extends 'baseadmin.html.twig' %}
        {% block body %}
            <h1>Vol index</h1>

            <table class="table">
                <thead>
                    <tr>
                        <th>Numero_vol</th>
                        <th>Compagnie</th>
                        <th>Prix</th>
                        <th>Disponible</th>
                        <th>Aero_depart</th>
                        <th>Aero_arrivee</th>
                        <th>Date_depart</th>
                        <th>Date_arrivee</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for vol in vols %}
                    <tr>
                        <td>{{ vol.numeroVol }}</td>
                        <td>{{ vol.compagnie }}</td>
                        <td>{{ vol.prix }}</td>
                        <td>{{ vol.disponible }}</td>
                        <td>{{ vol.aeroDepart }}</td>
                        <td>{{ vol.aeroArrivee }}</td>
                        <td>{{ vol.dateDepart ? vol.dateDepart|date('Y-m-d H:i:s') : '' }}</td>
                        <td>{{ vol.dateArrivee ? vol.dateArrivee|date('Y-m-d H:i:s') : '' }}</td>
                        <td>
                            <a href="{{ path('app_vol_show', {'id_vol': vol.idVol}) }}">show</a>
                            <a href="{{ path('app_vol_edit', {'id_vol': vol.idVol}) }}">edit</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="10">No records found</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>

            <a href="{{ path('app_vol_new') }}">Create new</a>
        {% endblock %}

