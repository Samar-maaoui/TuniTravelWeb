{% extends 'baseadmin.html.twig' %}

{% block body %}
    <div class="container mt-5">
        <h1 class="mb-4">Détails du vol</h1>

        <table class="table table-striped">
            <tbody>
                <tr><th>ID</th><td>{{ vol.idVol }}</td></tr>
                <tr><th>Numéro de vol</th><td>{{ vol.numeroVol }}</td></tr>
                <tr><th>Compagnie</th><td>{{ vol.compagnie }}</td></tr>
                <tr><th>Prix</th><td>{{ vol.prix }}</td></tr>
                <tr><th>Disponible</th><td>{{ vol.disponible ? 'Oui' : 'Non' }}</td></tr>
                <tr><th>Aéroport de départ</th><td>{{ vol.aeroDepart }}</td></tr>
                <tr><th>Aéroport d’arrivée</th><td>{{ vol.aeroArrivee }}</td></tr>
                <tr><th>Date de départ</th><td>{{ vol.dateDepart ? vol.dateDepart|date('Y-m-d H:i') : '—' }}</td></tr>
                <tr><th>Date d’arrivée</th><td>{{ vol.dateArrivee ? vol.dateArrivee|date('Y-m-d H:i') : '—' }}</td></tr>
            </tbody>
        </table>

        <div class="d-flex gap-2">
            {{ include('vol/_delete_form.html.twig') }}
        </div>

        <a href="{{ path('app_vol_index') }}" class="btn btn-secondary mt-3">← Retour à la liste</a>
    </div>
{% endblock %}
