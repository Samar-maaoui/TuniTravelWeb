{% extends 'baseclient.html.twig' %}

{% block title %}ITINIREVES - Mon Profil{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <style>
        .profile-container {
            margin-top: 40px;
            margin-bottom: 40px;
            position: relative;
        }
        .profile-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border-radius: 15px;
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.15);
            padding: 2.5rem;
            position: relative;
            width: 100%;
            max-width: 600px;
            margin: 0 auto;
        }
        .profile-title {
            text-align: center;
            margin-bottom: 2rem;
            font-weight: 600;
            color: #344767;
            font-size: 1.8rem;
        }
        .profile-photo {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            margin: 0 auto 1.5rem;
            display: block;
            border: 3px solid #4154f1;
        }
        .form-control {
            border-radius: 10px;
            padding: 0.75rem 1rem;
            border: 2px solid #e2e8f0;
            font-size: 1rem;
            width: 100%;
            margin-bottom: 0.5rem;
        }
        .btn-edit {
            background: linear-gradient(135deg, #4154f1, #2536b8);
            color: white;
            border: none;
            border-radius: 10px;
            padding: 0.75rem 1.5rem;
            transition: all 0.3s ease;
            font-size: 1rem;
            width: 48%;
        }
        .btn-edit:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(65, 84, 241, 0.4);
        }
        .btn-delete {
            background: linear-gradient(135deg, #dc3545, #b02a37);
            color: white;
            width: 48%;
        }
        .btn-delete:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(220, 53, 69, 0.4);
        }
        .form-error-message {
            color: #dc3545;
            font-size: 0.9rem;
            margin-top: 0.25rem;
            padding: 0.25rem 0.5rem;
            background-color: rgba(220, 53, 69, 0.1);
            border-radius: 5px;
           
        }
        .form-group {
            margin-bottom: 1.5rem;
        }
        .buttons-container {
            display: flex;
            justify-content: space-between;
            margin-top: 2rem;
            gap: 1rem;
        }
        .photo-preview-container {
            text-align: center;
            margin-bottom: 1.5rem;
        }
        .is-invalid {
            border-color: #dc3545 !important;
        }
        .disabled-field {
            background-color: #f8f9fa;
            cursor: not-allowed;
        }
        .form-label {
            font-weight: 500;
            margin-bottom: 0.5rem;
            display: block;
        }
         
        .invalid-feedback,
        .form-error {
            color: #dc3545;
            font-size: 0.875rem;
        }

    

    </style>
{% endblock %}

{% block body %}
<div class="profile-container">
    <div class="profile-card">
        <h2 class="profile-title">Mon Profil</h2>
{% for label, messages in app.session.flashbag.all() %}
    {% for message in messages %}
        <div class="alert alert-{{ label }}">
            {{ message }}
        </div>
    {% endfor %}
{% endfor %}
        {% if form is defined %}

            {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'needs-validation'}}) }}

            <div class="photo-preview-container">
                <img id="photoPreview" src="{{ asset(user.photo ? 'uploads/photos/' ~ user.photo : 'assets/img/default-avatar.png') }}" 
                     alt="Avatar" class="profile-photo">
            </div>

            <div class="form-group">
                <label class="form-label"></label>
                {{ form_widget(form.photo, {
                    'attr': {
                        'onchange': 'previewImage(this)',
                        'class': 'form-control' ~ (form_errors(form.photo) ? ' is-invalid' : '')
                    }
                }) }}
                <div class="form-error-message">
                {{ form_errors(form.photo) }}
                 </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label"></label>
                        {{ form_widget(form.nom, {
                            'attr': {
                                'class': 'form-control' ~ (form_errors(form.nom) ? ' is-invalid' : ''),
                                'placeholder': 'Votre nom'
                            }
                        }) }}
                           <div class="form-error-message">
                        {{ form_errors(form.nom) }}
                          </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label"></label>
                        {{ form_widget(form.prenom, {
                            'attr': {
                                'class': 'form-control' ~ (form_errors(form.prenom) ? ' is-invalid' : ''),
                                'placeholder': 'Votre prénom'
                            }
                        }) }}
                         <div class="form-error-message">
                        {{ form_errors(form.prenom) }}
                    </div>
                      </div>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label"></label>
                {{ form_widget(form.email, {
                    'attr': {
                        'class': 'form-control' ~ (form_errors(form.email) ? ' is-invalid' : ''),
                        'placeholder': 'Votre email'
                    }
                }) }}
                                         <div class="form-error-message">

                {{ form_errors(form.email) }}
                            </div>

            </div>

            <div class="form-group">
                <label class="form-label"></label>
                {{ form_widget(form.cin, {
                    'attr': {
                        'class': 'form-control disabled-field' ~ (form_errors(form.cin) ? ' is-invalid' : ''),
                        'placeholder': 'Votre CIN',
                        'disabled': 'disabled'
                    }
                }) }}
                                                         <div class="form-error-message">

                {{ form_errors(form.cin) }}
            </div>
                        </div>


            <div class="form-group">
                <label class="form-label"></label>
                {{ form_widget(form.telephone, {
                    'attr': {
                        'class': 'form-control' ~ (form_errors(form.telephone) ? ' is-invalid' : ''),
                        'placeholder': 'Votre numéro de téléphone'
                    }
                }) }}
                                                                         <div class="form-error-message">

                {{ form_errors(form.telephone) }}
            </div>
                        </div>


            <div class="form-group">
                <label class="form-label"></label>
                {{ form_widget(form.dateNaissance, {
                    'attr': {
                        'class': 'form-control disabled-field' ~ (form_errors(form.dateNaissance) ? ' is-invalid' : ''),
                        'disabled': 'disabled'
                    }
                }) }}
                                                                                         <div class="form-error-message">

                {{ form_errors(form.dateNaissance) }}
            </div>
            </div>

            <div class="form-group">
                <label class="form-label"></label>
                {{ form_widget(form.adresse, {
                    'attr': {
                        'class': 'form-control' ~ (form_errors(form.adresse) ? ' is-invalid' : ''),
                        'placeholder': 'Votre adresse'
                    }
                }) }}
                                                                                                         <div class="form-error-message">

                {{ form_errors(form.adresse) }}
            </div>
                        </div>


           
            <div class="buttons-container">
                <button type="submit" class="btn btn-edit">
                    <i class="bi bi-save me-2"></i>Enregistrer
                </button>
                <button type="button" class="btn btn-delete" data-bs-toggle="modal" data-bs-target="#deleteModal">
                    <i class="bi bi-trash me-2"></i>Supprimer
                </button>
            </div>

            {{ form_end(form) }}
        {% else %}
            <div class="alert alert-danger">Formulaire introuvable.</div>
        {% endif %}
    </div>
</div>

<!-- Modal de suppression de compte -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmer la suppression</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Attention : Cette action est irréversible. Toutes vos données seront définitivement supprimées.
                </div>
                <p>Êtes-vous sûr de vouloir supprimer votre compte ?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x me-2"></i>Annuler
                </button>
                <form action="{{ path('app_profile_delete') }}" method="post" style="display: inline;">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-2"></i>Supprimer mon compte
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('photoPreview').src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
{% endblock %}