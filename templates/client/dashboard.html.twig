        .profile-section {
            display: none;
            opacity: 0;
            transform: translateY(20px);
            transition: all 0.5s ease;
        }

        .profile-section.active {
            display: block;
            opacity: 1;
            transform: translateY(0);
        }

        .dashboard-section {
            opacity: 1;
            transform: translateY(0);
            transition: all 0.5s ease;
        }

        .dashboard-section.hidden {
            display: none;
            opacity: 0;
            transform: translateY(-20px);
        }

        /* Styles du profil */
        .profile-container {
            margin-top: 80px;
            margin-bottom: 40px;
        }

        .profile-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border-radius: 15px;
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.15);
            padding: 2rem;
        }

        .profile-photo {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            object-fit: cover;
            margin: 0 auto;
            display: block;
            border: 3px solid #4154f1;
        }

        .form-control {
            border-radius: 10px;
            padding: 0.75rem 1rem;
            border: 2px solid #e2e8f0;
        }

        .btn-edit {
            background: linear-gradient(135deg, #4154f1, #2536b8);
            color: white;
            border: none;
            border-radius: 10px;
            padding: 0.75rem 1.5rem;
            transition: all 0.3s ease;
        }

        .btn-edit:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(65, 84, 241, 0.4);
        }

        .btn-delete {
            background: linear-gradient(135deg, #dc3545, #b02a37);
            color: white;
        }

        .toggle-profile {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 1000;
            padding: 15px 30px;
            border-radius: 50px;
            background: linear-gradient(135deg, #4154f1, #2536b8);
            color: white;
            border: none;
            box-shadow: 0 4px 15px rgba(65, 84, 241, 0.3);
            transition: all 0.3s ease;
        }

        .toggle-profile:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(65, 84, 241, 0.4);
        }

        .email-warning {
            display: none;
            color: #dc3545;
            font-size: 0.875rem;
            margin-top: 0.25rem;
        }

        .email-changed .email-warning {
            display: block;
        }

        /* Modal Styles */
        .modal, .custom-modal {
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.5);
            display: none;
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background-color: #fff;
            padding: 20px;
            border-radius: 10px;
            width: 60%;
            max-height: 80%;
            overflow-y: auto;
            position: relative;
        }

        .close-modal {
            position: absolute;
            right: 20px;
            top: 20px;
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
        }

        .hidden-event {
            display: none;
        }

        /* Post Styles */
        .post-boxed {
            background: white;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            transition: transform 0.3s ease;
            height: 100%;
            display: flex;
            flex-direction: column;
            margin: 0 auto;
        }

        .post-boxed:hover {
            transform: translateY(-5px);
        }

        .post-boxed-image img {
            width: 100%;
            height: 240px;
            object-fit: cover;
        }

        .post-boxed-body {
            padding: 20px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }

        .post-boxed-footer {
            margin-top: auto;
            padding-top: 15px;
            text-align: center;
        }

        .divider-decorate {
            width: 100px;
            margin: 15px auto 30px;
        }
        
