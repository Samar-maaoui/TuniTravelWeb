<link rel="stylesheet" href="https://unpkg.com/leaflet@1.7.1/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.7.1/dist/leaflet.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const showMapBtn = document.getElementById('show-map-btn'); // Bouton pour afficher la carte
    const mapContainer = document.getElementById('map-container'); // Conteneur de la carte
    let mapInitialized = false;
    let map;

    // Ta API Key LocationIQ
    const apiKey = "pk.d23d607e10a7e14a3ec0d35a174b66e4";

 
    const excursions = [
        {% for excursion in excursions %}
        {
                       
             nom: "{{ excursion.nom|e('js') }}",

            lieu: "{{ excursion.lieu|e('js') }}",
            prix: "{{ excursion.prix }}",
            description: "{{ excursion.description|e('js')|default('Pas de description') }}",
            image: "{{ asset('uploads/excursions/' ~ excursion.image) }}"

        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ];

    // Écouteur d'événement pour afficher la carte au clic sur le bouton
    showMapBtn.addEventListener('click', async function() {
        if (!mapInitialized) {
            mapContainer.style.display = 'block'; // Affiche le conteneur de la carte

            // Initialise la carte centrée sur la Tunisie
            map = L.map('map-container').setView([34.0, 9.0],6);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 18,
                attribution: '© OpenStreetMap'
            }).addTo(map);

            // Cherche chaque lieu avec LocationIQ et place un marqueur
            for (const lieu of excursions) {
                const coords = await getCoordinatesFromLocationIQ(lieu.lieu); // Recherche des coordonnées via LocationIQ
                if (coords) {
                    L.marker([coords.lat, coords.lon])
                        .addTo(map)
                        .bindPopup(`
                        <div class="titlecard"> <strong>${lieu.nom}</strong></div>
                        <div class="pricecard"> <i class="fa-solid fa-dollar-sign"></i>  Prix: ${lieu.prix} TND</div>
                          <strong> ${lieu.description}</strong>
                            <img src="${lieu.image}" alt="${lieu.lieu}" width="200">
                        `);
                }
            }

            mapInitialized = true;
        } else {
            // Afficher / cacher la carte
            mapContainer.style.display = (mapContainer.style.display === 'none') ? 'block' : 'none';
        }
    });

    async function getCoordinatesFromLocationIQ(lieu) {
        const url = `https://us1.locationiq.com/v1/search.php?key=${apiKey}&q=${encodeURIComponent(lieu)}&format=json`;

        try {
            const response = await fetch(url);
            const data = await response.json();
            if (data && data.length > 0) {
                return {
                    lat: parseFloat(data[0].lat),
                    lon: parseFloat(data[0].lon)
                };
            } else {
                console.error("Pas de résultat pour : " + lieu);
            }
        } catch (error) {
            console.error("Erreur de LocationIQ :", error);
        }
        return null;
    }
});
</script>



    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>

        function animateValue(id, start, end, duration) {
            const obj = document.getElementById(id);
            let startTimestamp = null;
            const step = (timestamp) => {
                if (!startTimestamp) startTimestamp = timestamp;
                const progress = Math.min((timestamp - startTimestamp) / duration, 1);
                obj.innerHTML = Math.floor(progress * (end - start) + start);
                if (progress < 1) {
                    window.requestAnimationFrame(step);
                }
            };
            window.requestAnimationFrame(step);
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Start counters
            animateValue("clients-count", 0, 2500, 2000);
            animateValue("destinations-count", 0, 120, 1500);
            animateValue("years-count", 0, 14, 1000);

            // Satisfaction Chart
            const ctx = document.getElementById('satisfactionChart').getContext('2d');
            const chart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Service Client', 'Qualité des Hôtels', 'Transport', 'Expérience Globale'],
                    datasets: [{
                        data: [98, 96, 94, 97],
                        backgroundColor: [
                            'rgba(212, 175, 55, 0.8)',
                            'rgba(10, 26, 47, 0.8)',
                            'rgba(184, 134, 11, 0.8)',
                            'rgba(30, 58, 138, 0.8)'
                        ],
                        borderColor: [
                            'rgba(212, 175, 55, 1)',
                            'rgba(10, 26, 47, 1)',
                            'rgba(184, 134, 11, 1)',
                            'rgba(30, 58, 138, 1)'
                        ],
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'right',
                            labels: {
                                color: '#F8F8F8',
                                font: {
                                    size: 14
                                }
                            }
                        },
                        title: {
                            display: true,
                            text: 'Taux de Satisfaction (%)',
                            color: '#D4AF37',
                            font: {
                                size: 18,
                                family: "'Playfair Display', serif"
                            }
                        }
                    },
                    cutout: '70%',
                    animation: {
                        animateScale: true,
                        animateRotate: true
                    }
                }
            });

            // Luxury card hover effect enhancement
            const cards = document.querySelectorAll('.luxury-card');
            cards.forEach(card => {
                card.addEventListener('mouseenter', function() {
                    this.style.background = 'rgba(10, 26, 47, 0.95)';
                    this.style.borderColor = 'var(--dark-gold)';
                });
                card.addEventListener('mouseleave', function() {
                    this.style.background = 'rgba(10, 26, 47, 0.8)';
                    this.style.borderColor = 'var(--gold)';
                });
            });
        });
    </script>

{% endblock %}