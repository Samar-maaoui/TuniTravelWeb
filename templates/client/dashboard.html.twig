    {{ parent() }}
    <script>
document.addEventListener('DOMContentLoaded', function() {
    // 1. Generic Modal Handler
    function handleModal(triggerClass, modalId, bodyId, pathPattern) {
        document.querySelectorAll(triggerClass).forEach(button => {
            button.addEventListener('click', function(event) {
                event.preventDefault();
                event.stopPropagation();
                
                const id = this.getAttribute('data-id');
                const url = pathPattern.replace('__id__', id);
                const modal = document.getElementById(modalId);
                const body = document.getElementById(bodyId);

                modal.style.display = 'flex';
                body.innerHTML = `
                    <div class="text-center py-4">
                        <div class="spinner-border" role="status">
                            <span class="visually-hidden">Chargement...</span>
                        </div>
                    </div>
                `;

                fetch(url)
                    .then(response => {
                        if (!response.ok) throw new Error('Network response was not ok');
                        return response.text();
                    })
                    .then(html => body.innerHTML = html)
                    .catch(error => {
                        body.innerHTML = `
                            <div class="alert alert-danger">
                                Erreur lors du chargement: ${error.message}
                            </div>
                        `;
                    });
            });
        });
    }

    // Initialize all modals
    handleModal('.open-excursion-modal', 'excursion-modal', 'excursion-modal-body', '{{ path("client_excursions_show", {"id": "__id__"}) }}');
    handleModal('.open-modal', 'event-modal', 'modal-body', '{{ path("client_evenements_show", {"id": "__id__"}) }}');
    handleModal('.open-post-modal', 'post-modal', 'post-modal-body', '{{ path("client_post_show", {"id_post": "__id__"}) }}');

    // Generic modal close handlers
    document.querySelectorAll('.close-modal').forEach(button => {
        button.addEventListener('click', function() {
            this.closest('.modal').style.display = 'none';
        });
    });

    window.addEventListener('click', function(event) {
        ['excursion-modal', 'event-modal', 'post-modal'].forEach(id => {
            const modal = document.getElementById(id);
            if (modal && modal.style.display === 'flex') {
                const content = modal.querySelector('.modal-content');
                if (!content.contains(event.target)) {
                    modal.style.display = 'none';
                }
            }
        });
    });

    // 2. Filtering functionality (price and location)
    const priceSlider = document.getElementById('priceRange');
    const priceValue = document.getElementById('priceValue');
    const locationSelect = document.getElementById('location');

    function updateExcursions() {
        const location = locationSelect.value;
        const price = priceSlider.value;

        const url = new URL(window.location.href.split('?')[0]);
        if (location) url.searchParams.set('location', location);
        if (price) url.searchParams.set('price', price);

        fetch(url)
            .then(response => response.text())
            .then(html => {
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const newExcursions = doc.querySelector('.row-50').innerHTML;
                document.querySelector('.row-50').innerHTML = newExcursions;
                
                // Re-bind all events after content update
                handleModal('.open-excursion-modal', 'excursion-modal', 'excursion-modal-body', '{{ path("client_excursions_show", {"id": "__id__"}) }}');
            })
            .catch(error => console.error('Erreur filtrage:', error));
    }

    if (priceSlider && priceValue) {
        priceSlider.addEventListener('input', function() {
            priceValue.textContent = this.value;
            updateExcursions();
        });
    }

    if (locationSelect) {
        locationSelect.addEventListener('change', updateExcursions);
    }

    // 3. Toggle functionality for excursions and events
    function setupToggle(buttonId, itemClass, showText, hideText) {
        const button = document.getElementById(buttonId);
        if (!button) return;

        button.addEventListener('click', function() {
            const items = document.querySelectorAll(itemClass);
            if (items.length === 0) return;

            const isHidden = items[0].style.display === 'none' || 
                           items[0].style.display === '';
            
            items.forEach(item => {
                item.style.display = isHidden ? 'block' : 'none';
            });

            this.textContent = isHidden ? hideText : showText;
        });
    }

    setupToggle('toggle-excursions', '.hidden-excursion', 'Voir Toutes', 'Voir Moins');
    setupToggle('toggle-events', '.hidden-event', 'Voir Tous', 'Voir Moins');

    // 4. Email Change Handler
    const emailInput = document.querySelector('input[name="email"]');
    if (emailInput) {
        const originalEmail = emailInput.value;
        const form = emailInput.closest('form');

        emailInput.addEventListener('input', function() {
            this.closest('.mb-3').classList.toggle('email-changed', 
                this.value !== originalEmail);
        });

        form?.addEventListener('submit', function(e) {
            if (emailInput.value !== originalEmail && 
                !confirm('La modification de votre email nécessitera une reconnexion. Voulez-vous continuer ?')) {
                e.preventDefault();
            }
        });
    }
});
</script>

