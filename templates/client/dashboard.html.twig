        <script>
            document.getElementById('departure-select').addEventListener('change', function() {
                const selectedOption = this.options[this.selectedIndex];
                
                if (selectedOption.value) {
                    // Update all fields with the flight data
                    document.getElementById('arrival-input').value = selectedOption.dataset.arrivee;
                    document.getElementById('date-depart-input').value = selectedOption.dataset.dateDepart;
                    document.getElementById('date-arrivee-input').value = selectedOption.dataset.dateArrivee;
                    document.getElementById('compagnie-input').value = selectedOption.dataset.compagnie;
                    document.getElementById('prix-input').value = selectedOption.dataset.prix;
                    
                    // Update reservation link
                    if (document.getElementById('reservation-link')) {
                        const classe = document.getElementById('classe-select').value;
                        document.getElementById('reservation-link').href = 
                            "{{ path('app_reservation_vol_from_vol', { id_vol: 'VOL_ID' }) }}".replace('VOL_ID', selectedOption.value) + 
                            "?classe=" + encodeURIComponent(classe);
                    }
                } else {
                    // Clear all fields if no flight is selected
                    document.getElementById('arrival-input').value = '';
                    document.getElementById('date-depart-input').value = '';
                    document.getElementById('date-arrivee-input').value = '';
                    document.getElementById('compagnie-input').value = '';
                    document.getElementById('prix-input').value = '';
                }
            });
        
            // Update reservation link when class changes
            document.getElementById('classe-select').addEventListener('change', function() {
                const selectedVol = document.getElementById('departure-select').value;
                if (selectedVol) {
                    document.getElementById('reservation-link').href = 
                        "{{ path('app_reservation_vol_from_vol', { id_vol: 'VOL_ID' }) }}".replace('VOL_ID', selectedVol) + 
                        "?classe=" + encodeURIComponent(this.value);
                }
            });
        </script>
    
