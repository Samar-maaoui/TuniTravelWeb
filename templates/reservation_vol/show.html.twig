{% extends 'baseclient.html.twig' %}

{% block body %}
    <h1>Détails de la Réservation Vol</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>ID Réservation</th>
                <td>{{ reservationvol.idReservation }}</td>
            </tr>
            <tr>
                <th>Vol ID</th>
                <td>{{ reservationvol.volId }}</td>
            </tr>
            <tr>
                <th>Classe</th>
                <td>{{ reservationvol.classeService }}</td>
            </tr>
            <tr>
                <th>Utilisateur</th>
                <td>
                    {{ reservationvol.utilisateur.prenom }} {{ reservationvol.utilisateur.nom }}
                    {# ou {{ reservationvol.utilisateur.email }} selon les champs dispo #}
                </td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_reservation_vol_index') }}">⬅ Retour à la liste</a>
    <a href="{{ path('app_reservation_vol_edit', {'id_reservation': reservationvol.idReservation}) }}">✏ Modifier</a>

    {{ include('reservation_vol/_delete_form.html.twig') }}
{% endblock %}
