{% extends 'baseadmin.html.twig' %}

{% block body %}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }}">
            {{ message }}
        </div>
    {% endfor %}
{% endfor %}

<div class="verification-container">
    <h1 class="title">Vérification d'identité</h1>

    <div id="camera-container" class="camera-box">
        <video id="video" width="400" height="300" autoplay></video>
        <button id="capture-btn" class="capture-button">📸 Capturer</button>
    </div>

    <form id="verification-form" method="POST" enctype="multipart/form-data" style="display:none;">
        <input type="file" id="webcam-photo" name="webcam_photo" accept="image/*">
        <button type="submit" class="submit-button">Envoyer</button>
    </form>

    <!-- Zone de Loading -->
    <div id="loading" class="loading-box" style="display:none;">
        <h2 class="loading-text">Vérification en cours...</h2>
        <div class="loader"></div>
    </div>
</div>

<style>
/* Container principal */
.verification-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 40px;
    background: #f9fafb;
    border-radius: 20px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.1);
    margin: 30px auto;
    max-width: 700px;
}

/* Titre */
.title {
    font-size: 32px;
    margin-bottom: 20px;
    color: #2c3e50;
}

/* Boîte caméra */
.camera-box {
    position: relative;
    background: white;
    padding: 20px;
    border-radius: 20px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    margin-bottom: 30px;
}

/* Bouton capturer */
.capture-button {
    margin-top: 10px;
    background-color: #3498db;
    border: none;
    color: white;
    padding: 12px 20px;
    font-size: 16px;
    border-radius: 10px;
    cursor: pointer;
    transition: background-color 0.3s ease;
}

.capture-button:hover {
    background-color: #2980b9;
}

/* Loader */
.loader {
    border: 8px solid #f3f3f3;
    border-top: 8px solid #3498db;
    border-radius: 50%;
    width: 80px;
    height: 80px;
    animation: spin 1s linear infinite;
    margin: 20px auto;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

/* Loading */
.loading-box {
    text-align: center;
    padding: 40px;
}

.loading-text {
    font-size: 24px;
    margin-bottom: 20px;
    color: #34495e;
}

/* Animation de flash lors de capture */
.flash {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    background: white;
    opacity: 0;
    animation: flashAnim 0.5s forwards;
    border-radius: 20px;
}

@keyframes flashAnim {
    0% { opacity: 1; }
    100% { opacity: 0; }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const video = document.getElementById('video');
    const captureBtn = document.getElementById('capture-btn');
    const verificationForm = document.getElementById('verification-form');
    const webcamPhoto = document.getElementById('webcam-photo');
    const loading = document.getElementById('loading');
    const cameraContainer = document.getElementById('camera-container');

    // Démarrer la webcam
    navigator.mediaDevices.getUserMedia({ video: true })
        .then(stream => {
            video.srcObject = stream;
        })
        .catch(error => {
            console.error('Erreur caméra:', error);
        });

    captureBtn.addEventListener('click', function() {
        // Animation flash
        const flash = document.createElement('div');
        flash.classList.add('flash');
        cameraContainer.appendChild(flash);

        setTimeout(() => {
            flash.remove();
        }, 500);

        // Capture de la photo
        const canvas = document.createElement('canvas');
        canvas.width = video.videoWidth;
        canvas.height = video.videoHeight;
        canvas.getContext('2d').drawImage(video, 0, 0);

        canvas.toBlob(function(blob) {
            const file = new File([blob], "capture.jpg", { type: "image/jpeg" });
            const dataTransfer = new DataTransfer();
            dataTransfer.items.add(file);
            webcamPhoto.files = dataTransfer.files;

            // ✅ Masquer la caméra et bouton capture
            cameraContainer.style.display = 'none';

            // ✅ Afficher l'animation de chargement
            loading.style.display = 'block';

            // ✅ Arrêter la caméra
            const stream = video.srcObject;
            const tracks = stream.getTracks();
            tracks.forEach(track => track.stop());

            // ✅ Envoyer le formulaire automatiquement
            verificationForm.submit();
        }, 'image/jpeg');
    });
});
</script>

{% endblock %}
