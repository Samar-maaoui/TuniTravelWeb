{% extends 'baseadmin.html.twig' %}
{% block body %}
    <h1>Guide</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id_guide</th>
                <td>{{ guide.idGuide }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ guide.nom }}</td>
            </tr>
            <tr>
                <th>Prenom</th>
                <td>{{ guide.prenom }}</td>
            </tr>
           
            <tr>
                <th>Langues</th>
                <td>{{ guide.langues }}</td>
            </tr>
            <tr>
                <th>NumeroTel</th>
                <td>{{ guide.numeroTel }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ guide.email }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td>{{ guide.image }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_guide_index') }}">back to list</a>
    <a href="{{ path('app_guide_edit', {'id_guide': guide.getIdGuide}) }}">edit</a>
    
    
     {{ include('guide/_delete_form.html.twig') }}

{% endblock %}
