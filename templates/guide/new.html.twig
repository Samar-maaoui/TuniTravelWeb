{% extends 'baseadmin.html.twig' %}


{% block body %}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
{% endfor %}

<style>
.title{
    color:  #00008B;
}
 .alert-success {
        color: #155724;
        background-color: #d4edda;
        border: 1px solid #c3e6cb;
        padding: 10px;
        margin-bottom: 20px;
        border-radius: 4px;
    }

    .btn-close {
        float: right;
        background: none;
        border: none;
        font-weight: bold;
        font-size: 20px;
        line-height: 1;
        color: #000;
    }
    .form-error, .symfony-form-error, .invalid-feedback, ul.form-error li, .errors {
        color: red;
        font-weight: bold;
        margin-top: 10px;
        list-style: none;
        padding-left: 0;
    }

    label {
        color: #00008B;
        font-weight: bold;
    }

    .form-input, .form-textarea, .form-control {
        width: 100%;
        padding: 8px;
        margin-bottom: 10px;
    }
.title{
    color:  #00008B;
}
    .btn-submit {
        background-color: #FF8C00;
        color: white;
        padding: 10px 15px;
        border-radius: 30px;
        cursor: pointer;
    }

    .btn-submit:hover {
        background-color: orange  ;
    }

    .form-card {
        width: 60%;
        margin: auto;
    }
</style>
<center><h1> Ajouter un guide:</h1></center>
 <form method="post" enctype="multipart/form-data" class="form-card">
    {{ form_start(form) }}
    
    {% for field in ['nom', 'prenom', 'numeroTel', 'email', 'image'] %}
        <div class="form-group">
            {{ form_label(attribute(form, field)) }}

            {{ form_widget(attribute(form, field), {
                'attr': {
                    'class': attribute(form, field).vars.errors|length > 0 ? 'form-control is-invalid' : 'form-control'
                }
            }) }}

            {% if attribute(form, field).vars.errors|length > 0 %}
                <div class="invalid-feedback d-block text-danger">
                    {{ form_errors(attribute(form, field)) }}
                </div>
            {% endif %}
        </div>
    {% endfor %}

   <div class="form-group">
    <label for="guide_langues_0">Langues parlées</label>
    <div id="guide_langues">
        {% for checkbox in form.langues %}
            <div class="form-check">
                {{ form_widget(checkbox) }}
                {{ form_label(checkbox) }}
            </div>
        {% endfor %}
    </div>
    {{ form_errors(form.langues) }}
</div>


    <button type="submit" class="btn-submit">Ajouter Guide</button>

    {{ form_end(form) }}
</form>

{% endblock %}
