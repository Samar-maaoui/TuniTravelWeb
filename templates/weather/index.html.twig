{% block title %}Weather Forecast{% endblock %}

{% block body %}
<div style="max-width: 800px; margin: auto; background: #ecf0f1; padding: 30px; border-radius: 10px; margin-top: 40px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);">
    <h2>🌤️ Check the Weather</h2>

    <form method="get" action="{{ path('weather') }}">
        <input type="text" name="city" placeholder="Enter a city..." required
               style="padding: 10px; width: 70%; border-radius: 5px; border: 1px solid #ccc;">
        <button type="submit"
                style="padding: 10px 15px; background-color: #2ecc71; color: white; border: none; border-radius: 5px;">
            Check Weather
        </button>
    </form>

    {% if city and weather %}
        <hr>
        <h3>Weather in {{ city }}</h3>
        
        <div style="display: flex; flex-wrap: wrap; justify-content: space-between;">
            <div style="flex: 1; margin-right: 15px; text-align: center;">
                <img src="https://openweathermap.org/img/wn/{{ weather.weather[0].icon }}@2x.png" alt="Weather icon" />
                <p><strong>{{ weather.weather[0].description | capitalize }}</strong></p>
                <p>🌡️ Temperature: {{ weather.main.temp }}°C</p>
                <p>💧 Humidity: {{ weather.main.humidity }}%</p>
            </div>
            <div style="flex: 1;">
                <canvas id="weatherChart" style="max-height: 400px;"></canvas>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            var ctx = document.getElementById('weatherChart').getContext('2d');
            var weatherChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Sun', 'Rain', 'Temperature'],
                    datasets: [{
                        label: 'Weather Data',
                        data: [
                            {{ weather.sys.sunrise | date('H:i') }},  // Show sun time
                            {{ weather.weather[0].main == 'Rain' ? 100 : 0 }},  // Show rain status (100% if rain)
                            {{ weather.main.temp }}  // Show current temperature
                        ],
                        backgroundColor: [
                            'rgba(255, 223, 0, 0.8)',  // Yellow for Sun
                            'rgba(0, 0, 255, 0.8)',  // Blue for Rain
                            'rgba(255, 99, 132, 0.8)'  // Red for Temperature
                        ],
                        borderColor: 'rgba(0, 0, 0, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                stepSize: 5
                            }
                        },
                        x: {
                            title: {
                                display: true,
                                text: 'Weather Elements'
                            }
                        }
                    }
                }
            });
        </script>
    {% elseif city %}
        <p style="color: red; margin-top: 15px;">City not found or error fetching weather.</p>
    {% endif %}
</div>
{% endblock %}
