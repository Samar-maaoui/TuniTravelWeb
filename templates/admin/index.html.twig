{% extends 'baseadmin.html.twig' %}

{% block title %}User Management{% endblock %}

{% block body %}
    <div class="pagetitle">
        <h1>User Management</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('admin_users_list') }}">Accueil</a></li>
                <li class="breadcrumb-item active">Users</li>
            </ol>
        </nav>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <section class="section">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Users List</h5>
<!-- Stats Section -->
<div class="row mb-4">
    <div class="col-md-5">  {# Changé de 6 à 5 pour réduire la taille #}
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title text-center">Statut des comptes</h5>
                <div class="chart-container" style="height:200px;">  {# Hauteur réduite #}
                    <canvas id="usersChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-7">  {# Changé de 6 à 7 #}
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title text-center">Répartition des utilisateurs</h5>
                <div class="row text-center">
                    <div class="col-md-4 mb-3">
                        <div class="p-3 bg-light rounded">
                            <h6 class="mb-0">Comptes vérifiés</h6>
                            <h3 class="mb-0 text-success">{{ stats.verified }}</h3>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="p-3 bg-light rounded">
                            <h6 class="mb-0">Comptes non vérifiés</h6>
                            <h3 class="mb-0 text-warning">{{ stats.unverified }}</h3>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="p-3 bg-light rounded">
                            <h6 class="mb-0">Total</h6>
                            <h3 class="mb-0">{{ stats.total }}</h3>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded">
                            <h6 class="mb-0">Administrateurs</h6>
                            <h3 class="mb-0 text-primary">{{ stats.admins }}</h3>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded">
                            <h6 class="mb-0">VIP</h6>
                            <h3 class="mb-0 text-danger">{{ stats.vips }}</h3>  {# Nouvelle couleur pour VIP #}
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded">
                            <h6 class="mb-0">Normaux</h6>
                            <h3 class="mb-0 text-info">{{ stats.normals }}</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
                        <form method="get" action="{{ path('admin_user_search') }}" class="row g-3 align-items-center mb-3">
                            <div class="col-auto">
                                <input type="text" name="query" placeholder="Rechercher..." class="form-control" value="{{ search_query|default('') }}">
                            </div>

                            <div class="col-auto">
                                <select name="isVerified" class="form-select">
                                    <option value="">-- Tous les comptes --</option>
                                    <option value="1" {% if is_verified == '1' %}selected{% endif %}>Comptes Vérifiés</option>
                                    <option value="0" {% if is_verified == '0' %}selected{% endif %}>Comptes Non Vérifiés</option>
                                </select>
                            </div>

                            <div class="col-auto">
                                <select name="sort" class="form-select">
                                    <option value="">-- Trier par --</option>
                                    <option value="nom_asc" {% if sort == 'nom_asc' %}selected{% endif %}>Nom (A-Z)</option>
                                    <option value="nom_desc" {% if sort == 'nom_desc' %}selected{% endif %}>Nom (Z-A)</option>
                                    <option value="date_asc" {% if sort == 'date_asc' %}selected{% endif %}>Date création ↑</option>
                                    <option value="date_desc" {% if sort == 'date_desc' %}selected{% endif %}>Date création ↓</option>
                                </select>
                            </div>

                            <div class="col-auto">
                                <button type="submit" class="btn btn-primary">Appliquer</button>
                            </div>
                        </form>

                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Photo</th>
                                        <th>Nom</th>
                                        <th>Prénom</th>
                                        <th>Email</th>
                                        <th>CIN</th>
                                        <th>Adresse</th>
                                        <th>Date Naissance</th>
                                        <th>Téléphone</th>
                                        <th>Type</th>
                                        <th>Status</th>
                                        <th>Date Création</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% if users is defined and users|length > 0 %}
                                        {% for user in users %}
                                            <tr>
                                                <td>
                                                    {% if user.photo %}
                                                        <img src="{{ asset('uploads/photos/' ~ user.photo) }}" alt="Profile" class="rounded-circle" width="40">
                                                    {% else %}
                                                        <img src="{{ asset('assets/img/default-avatar.png') }}" alt="Profile" class="rounded-circle" width="40">
                                                    {% endif %}
                                                </td>
                                                <td>{{ user.nom }}</td>
                                                <td>{{ user.prenom }}</td>
                                                <td>{{ user.email }}</td>
                                                <td>{{ user.cin }}</td>
                                                <td>{{ user.adresse }}</td>
                                                <td>{{ user.dateNaissance|date('Y-m-d') }}</td>
                                                <td>{{ user.telephone }}</td>
                                                <td>
                                                    <span class="badge bg-{{ user.typeUtilisateur == 'Admin' ? 'primary' : 'info' }}">
                                                        {{ user.typeUtilisateur }}
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="badge {{ user.isVerified ? 'bg-success' : 'bg-warning' }}">
                                                        {{ user.isVerified ? 'Verifiee' : 'Non verifiee' }}
                                                    </span>
                                                </td>
                                                <td>{{ user.dateCreation|date('Y-m-d H:i') }}</td>
                                                <td>
                                                    <div class="d-flex gap-2">
                                                        {% if not user.isVerified %}
                                                            <form method="post" action="{{ path('admin_user_validate', {'id': user.id}) }}">
                                                                <button type="submit" class="btn btn-sm btn-success">
                                                                    <i class="bi bi-check"></i> vérifier
                                                                </button>
                                                            </form>
                                                        {% endif %}
                                                        <form method="get" action="{{ path('admin_user_confirm_delete', {'id': user.id}) }}">
                                                            <button type="submit" class="btn btn-sm btn-danger">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    {% else %}
                                        <tr>
                                            <td colspan="12" class="text-center">Aucun utilisateur trouvé</td>
                                        </tr>
                                    {% endif %}
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </section>
    <style>
  .chart-container {
    margin: 0 auto;
    max-width: 300px;
}
.bg-light {
    background-color: #f8f9fa !important;
}
.rounded {
    border-radius: 0.5rem !important;
}
.text-success {
    color: #28a745 !important;
}
.text-warning {
    color: #ffc107 !important;
}
.text-primary {
    color: #007bff !important;
}
.text-info {
    color: #17a2b8 !important;
}
.chart-container {
    margin: 0 auto;
    max-width: 250px;  {# Largeur réduite #}
    position: relative;
}
.text-danger {
    color: #dc3545 !important;  {# Couleur pour VIP #}
}
</style>
{% endblock %}
{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const ctx = document.getElementById('usersChart');
    
    {% if stats is defined %}
    new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: ['Vérifiés', 'Non vérifiés'],
            datasets: [{
                data: [{{ stats.verified }}, {{ stats.unverified }}],
                backgroundColor: [
                    '#28a745',
                    '#ffc107'
                ],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,  {# Ajouté pour mieux contrôler la taille #}
            plugins: {
                legend: {
                    position: 'bottom',  {# Changé de 'right' à 'bottom' #}
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return `${context.label}: ${context.raw} (${Math.round(context.parsed)}%)`;
                        }
                    }
                }
            }
        }
    });
    {% endif %}
});
</script>
{% endblock %}
