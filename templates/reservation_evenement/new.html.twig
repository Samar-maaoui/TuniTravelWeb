{% block body %}
    <div class="d-flex justify-content-center align-items-center min-vh-100">
        <div class="form-container">
            <h2 class="text-center mb-4">{{ event.nom }}</h2>
            
            {{ form_start(form, {'attr': {'class': 'form-horizontal'}}) }}
                <div class="mb-3">
                    {{ form_label(form.nombre_places, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.nombre_places, {'attr': {'class': 'form-control custom-input'}}) }}
                </div>
                


    <div class="d-grid">
        <button type="submit" class="btn btn-primary btn-lg">
            Passer au paiement <i class="fas fa-arrow-right ms-2"></i>
        </button>
    </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <style>
        .form-container {
            max-width: 600px;
            width: 100%;
            padding: 2.5rem;
            background-color: #fff;
            border-radius: 15px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            margin: 2rem;
        }
        
        .custom-input, .custom-select {
            border-radius: 8px;
            padding: 12px 15px;
            border: 1px solid #ced4da;
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
        }
        
        .custom-input:focus, .custom-select:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
            outline: 0;
        }
        
        .form-label {
            font-weight: 500;
            margin-bottom: 0.5rem;
            color: #495057;
        }
        
        .btn-primary {
            background-color: #0d6efd;
            border: none;
            padding: 12px 20px;
            font-weight: 500;
            transition: all 0.3s ease;
        }
        
        .btn-primary:hover {
            background-color: #0b5ed7;
            transform: translateY(-2px);
        }
        
        body {
            background-color: #f8f9fa;
        }
        
        h2 {
            color: #212529;
            font-weight: 600;
        }
    </style>
{% endblock %}