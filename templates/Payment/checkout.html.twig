

{% block body %}
<div class="container mt-5">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h4>Test Payment for Event: {{ event.nom }}</h4>
        </div>
        <div class="card-body">
            <h5>Static Payment Data:</h5>
            <table class="table table-bordered">
                {% for key, value in payment_data %}
                <tr>
                    <th>{{ key|replace({'_': ' '})|title }}</th>
                    <td>{{ value }}</td>
                </tr>
                {% endfor %}
            </table>
            
            <div class="mt-4">
                <a href="{{ path('payment_success') }}" class="btn btn-success">
                    Simulate Successful Payment
                </a>
                <a href="{{ path('payment_cancel') }}" class="btn btn-danger">
                    Simulate Cancelled Payment
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}