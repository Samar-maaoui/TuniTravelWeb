{% extends 'baseadmin.html.twig' %}

{% block body %}
  

    <!-- Back to list button (Top Right) -->
    <a href="{{ path('app_evenements_index') }}" class="return-btn">
        <i class="fas fa-arrow-left"></i> Retour
    </a>


    <table class="table">
        <tbody>
            <tr>
                <th>Nom</th>
                <td>{{ evenement.nom }}</td>
            </tr>
            <tr>
                <th>Lieu</th>
                <td>{{ evenement.lieu }}</td>
            </tr>
            <tr>
                <th>Date evenement</th>
                <td>{{ evenement.dateEvenement ? evenement.dateEvenement|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Capacite</th>
                <td>{{ evenement.capacite }}</td>
            </tr>
            <tr>
                <th>Type</th>
                <td>{{ evenement.type }}</td>
            </tr>
            <tr>
                <th>Organisateur</th>
                <td>{{ evenement.organisateur }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td class="single-line">{{ evenement.description }}</td>

            </tr>
            <tr>
                <th>Prix</th>
                <td>{{ evenement.prix }}</td>
            </tr>
            <tr>
                <th>image</th>
                <td><img src="{{ asset('images/' ~ evenement.getImage) }}" alt="{{ evenement.nom }}" width="100s" height="50"/> </td>
            </tr>
        </tbody>
    </table>
    <div class="action-buttons">
    <!-- Edit button (Pencil Icon) -->
    <a href="{{ path('app_evenements_edit', {'id': evenement.id}) }}" class="action-btn">
        <i class="fas fa-edit"></i>
    </a>

 
    <form method="post" action="{{ path('app_evenements_delete', {'id': evenement.id}) }}" 
    onsubmit="return confirm('Are you sure you want to delete this event?');">
  <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evenement.id) }}">
  <button type="submit" class="action-btn">
      <i class="fas fa-trash"></i>
  </button>
</form>
</div>

{% endblock %}
